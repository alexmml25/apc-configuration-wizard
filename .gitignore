# Git holds only what the APC Configuration Manager needs (whitelist), plus the VM probe tools and the installer
# source. Everything else - tests, notes (docs\), VM exports, decompiled code, binaries copied from VMs, handoffs -
# stays local and is never committed.
/*
!/.gitignore
!/.gitattributes
!/Start-Wizard.cmd
!/APC_ConfigWizard.ps1
!/APC_Config.ps1
!/APC_ConfigManifest.json
!/APC Logo.png
!/APC Configuration Manager Icon.png

# Modules: everything the Configuration Manager loads (modules\800xA = the 800xA kit, byte for byte)
!/modules/

# Templates: the D01555624 rev C checklist and the file-flow test files
!/Templates/
/Templates/*
!/Templates/D01555624_C_EN.docx
!/Templates/FileFlowTest_CTSCAN1.csv
!/Templates/FileFlowTest_CMM1.csv

# Installer source (Inno Setup 6): APC_Configuration_Manager.iss + the .ico; its build output stays local
!/installer/
/installer/Output/

# Read-only probe tools run on the VM (not installed); the deviceWise binary / abandoned-API tools stay local
!/tools/
/tools/Find-DwStrings.ps1
/tools/Inspect-DwGateway.ps1
/tools/Test-DwHttpApi.ps1

# Never: runtime output, Office lock files, macOS / Windows metadata
*.log
*.config_state.json
~$*
.DS_Store
._*
Thumbs.db
desktop.ini
