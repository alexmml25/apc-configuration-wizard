      { "ItemId": "Cell_{CELL}:Shift1Hour", "Value": "{SHIFT1HOUR}",    "Type": "Int32", "Min": 0, "Max": 23, "When": "VERIFYONSHIFT", "Description": "Verification GP: first shift start hour (0-23)" },
      { "ItemId": "Cell_{CELL}:VerificationOnShift", "Value": "{VERIFYONSHIFT}", "Type": "Bool", "Description": "Verification GP: False = button press only, True = button press or shift change" }
