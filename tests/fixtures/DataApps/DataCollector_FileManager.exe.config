<?xml version="1.0" encoding="utf-8"?>
<configuration>
		<configSections>
				<section name="AppSettingsSection" type="CommonLib.Utilities.AppsSettingsSection, CommonLib" />
				<section name="Paths" type="CommonLib.Utilities.MyCustomSectionHandler, CommonLib" />
				<section name="CNCSettings" type="CommonLib.Utilities.MyCustomSectionHandler, CommonLib" />
		</configSections>
		<AppSettingsSection>
				<Name>File Manager For Data Collector</Name>
				<Version>1.0.1.0</Version>
				<AllowMultipleInstances>false</AllowMultipleInstances>
				<NotifyIconMode>false</NotifyIconMode>
				<ThreadCount>8</ThreadCount>
				<OPCUA>opc.tcp://localhost:48020</OPCUA>
				<OPCUAUser>MedtronicSU</OPCUAUser>
				<OPCUAPwd>TTNkdHIwbjFjXzIwMjI=</OPCUAPwd>
		</AppSettingsSection>
		<CNCSettings>
				<CNC1.Asset>
						<Asset>CNC1</Asset>
						<CNCAssetPath>ns=2;s=CNC1.CNCAsset</CNCAssetPath>
						<CheckMismatchData>true</CheckMismatchData>
						<PartNumberPath>ns=2;s=CNC1.DOC-CHMI.RunningPartNumber</PartNumberPath>
						<BatchNumberPath>ns=2;s=CNC1.DOC-CHMI.RunningBatchNumber</BatchNumberPath>
						<ProcessNamePath>ns=2;s=CNC1.MeasurementUI.ProcessName</ProcessNamePath>
						<SampleNumberPath>ns=2;s=CNC1.MeasurementUI.SampleNumber</SampleNumberPath>
				</CNC1.Asset>
				<CNC2.Asset>
						<Asset>CNC2</Asset>
						<CNCAssetPath>ns=2;s=CNC2.CNCAsset</CNCAssetPath>
						<CheckMismatchData>true</CheckMismatchData>
						<PartNumberPath>ns=2;s=CNC2.DOC-CHMI.RunningPartNumber</PartNumberPath>
						<BatchNumberPath>ns=2;s=CNC2.DOC-CHMI.RunningBatchNumber</BatchNumberPath>
						<ProcessNamePath>ns=2;s=CNC2.MeasurementUI.ProcessName</ProcessNamePath>
						<SampleNumberPath>ns=2;s=CNC2.MeasurementUI.SampleNumber</SampleNumberPath>
				</CNC2.Asset>
				<CNC3.Asset>
						<Asset>CNC3</Asset>
						<CNCAssetPath>ns=2;s=CNC3.CNCAsset</CNCAssetPath>
						<CheckMismatchData>true</CheckMismatchData>
						<PartNumberPath>ns=2;s=CNC3.DOC-CHMI.RunningPartNumber</PartNumberPath>
						<BatchNumberPath>ns=2;s=CNC3.DOC-CHMI.RunningBatchNumber</BatchNumberPath>
						<ProcessNamePath>ns=2;s=CNC3.MeasurementUI.ProcessName</ProcessNamePath>
						<SampleNumberPath>ns=2;s=CNC3.MeasurementUI.SampleNumber</SampleNumberPath>
				</CNC3.Asset>
		</CNCSettings>
		<Paths>
				<Path1>
						<Name>CMM1</Name>
						<Path>C:\Medtronic\DataCollector_Data\CMM</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\CMM</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\CMM\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>CNCAsset</AssetKeyword>
						<AssetPrefix>"Desc,CNCAsset: </AssetPrefix>
						<AssetPostfix>",,,,,,,,,,</AssetPostfix>
						<PartNumberKeyword>Part Name</PartNumberKeyword>
						<PartNumberPrefix>"Part Name",</PartNumberPrefix>
						<PartNumberPostfix>,,,,,,,,,</PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>"Desc,Lot Number: </BatchNumberPrefix>
						<BatchNumberPostfix>",,,,,,,,,,</BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>"Desc,Sample: </SampleNumberPrefix>
						<SampleNumberPostfix>",,,,,,,,,,</SampleNumberPostfix>
						<DataTypeKeyword>ProcessName</DataTypeKeyword>
						<DataTypePrefix>"Desc,ProcessName: </DataTypePrefix>
						<DataTypePostfix>",,,,,,,,,,</DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path1>
				<Path2>
						<Name>CTSCAN1</Name>
						<Path>C:\Medtronic\DataCollector_Data\CTSCAN</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\CTSCAN</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\CTSCAN\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>Machine Asset</AssetKeyword>
						<AssetPrefix>Machine Asset #,</AssetPrefix>
						<AssetPostfix></AssetPostfix>
						<PartNumberKeyword>Part Name</PartNumberKeyword>
						<PartNumberPrefix>Part Name,</PartNumberPrefix>
						<PartNumberPostfix></PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>Lot Number ,</BatchNumberPrefix>
						<BatchNumberPostfix></BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>Sample #,</SampleNumberPrefix>
						<SampleNumberPostfix></SampleNumberPostfix>
						<DataTypeKeyword>Process Name</DataTypeKeyword>
						<DataTypePrefix>Process Name,</DataTypePrefix>
						<DataTypePostfix></DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path2>
				<Path3>
						<Name>BENCH</Name>
						<Path>C:\Medtronic\DataCollector_Data\BENCH</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\BENCH</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\BENCH\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>Machine Asset #</AssetKeyword>
						<AssetPrefix>Machine Asset #,</AssetPrefix>
						<AssetPostfix>,,,,</AssetPostfix>
						<PartNumberKeyword>Part Name</PartNumberKeyword>
						<PartNumberPrefix>Part Name,</PartNumberPrefix>
						<PartNumberPostfix></PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>Lot Number,</BatchNumberPrefix>
						<BatchNumberPostfix></BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>Sample #,</SampleNumberPrefix>
						<SampleNumberPostfix></SampleNumberPostfix>
						<DataTypeKeyword>Process Name</DataTypeKeyword>
						<DataTypePrefix>Process Name,</DataTypePrefix>
						<DataTypePostfix>,,,,</DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path3>
				<Path4>
						<Name>CONTRACER1</Name>
						<Path>C:\Medtronic\DataCollector_Data\CONTRACER</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\CONTRACER</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\CONTRACER\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>CNCAsset</AssetKeyword>
						<AssetPrefix>"Desc,CNCAsset",",</AssetPrefix>
						<AssetPostfix>,",,,,,,,,,,,,,</AssetPostfix>
						<PartNumberKeyword>PartName</PartNumberKeyword>
						<PartNumberPrefix>"Desc,PartName",",</PartNumberPrefix>
						<PartNumberPostfix>,",,,,,,,,,,,,,</PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>"Desc,Lot Number:",",</BatchNumberPrefix>
						<BatchNumberPostfix>,",,,,,,,,,,,,,</BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>"Desc,Sample:",",</SampleNumberPrefix>
						<SampleNumberPostfix>,",,,,,,,,,,,,,</SampleNumberPostfix>
						<DataTypeKeyword>ProcessName</DataTypeKeyword>
						<DataTypePrefix>"Desc,ProcessName",",</DataTypePrefix>
						<DataTypePostfix>,",,,,,,,,,,,,,</DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path4>
				<Path5>
						<Name>CONTRACER2</Name>
						<Path>C:\Medtronic\DataCollector_Data\CONTRACER</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\CONTRACER</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\CONTRACER\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>CNCAsset</AssetKeyword>
						<AssetPrefix>"Desc,CNCAsset",",</AssetPrefix>
						<AssetPostfix>,",,,,,,,,,,,,,</AssetPostfix>
						<PartNumberKeyword>PartName</PartNumberKeyword>
						<PartNumberPrefix>"Desc,PartName",",</PartNumberPrefix>
						<PartNumberPostfix>,",,,,,,,,,,,,,</PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>"Desc,Lot Number:",",</BatchNumberPrefix>
						<BatchNumberPostfix>,",,,,,,,,,,,,,</BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>"Desc,Sample:",",</SampleNumberPrefix>
						<SampleNumberPostfix>,",,,,,,,,,,,,,</SampleNumberPostfix>
						<DataTypeKeyword>ProcessName</DataTypeKeyword>
						<DataTypePrefix>"Desc,ProcessName",",</DataTypePrefix>
						<DataTypePostfix>,",,,,,,,,,,,,,</DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path5>
				<Path6>
						<Name>CONTRACER3</Name>
						<Path>C:\Medtronic\DataCollector_Data\CONTRACER</Path>
						<NewPath>C:\Medtronic\DataCollector_Data\CONTRACER</NewPath>
						<ErrorPath>C:\Medtronic\DataCollector_Data\CONTRACER\DoneError</ErrorPath>
						<Interval>5000</Interval>
						<AssetKeyword>CNCAsset</AssetKeyword>
						<AssetPrefix>"Desc,CNCAsset",",</AssetPrefix>
						<AssetPostfix>,",,,,,,,,,,,,,</AssetPostfix>
						<PartNumberKeyword>PartName</PartNumberKeyword>
						<PartNumberPrefix>"Desc,PartName",",</PartNumberPrefix>
						<PartNumberPostfix>,",,,,,,,,,,,,,</PartNumberPostfix>
						<BatchNumberKeyword>Lot Number</BatchNumberKeyword>
						<BatchNumberPrefix>"Desc,Lot Number:",",</BatchNumberPrefix>
						<BatchNumberPostfix>,",,,,,,,,,,,,,</BatchNumberPostfix>
						<SampleNumberKeyword>Sample</SampleNumberKeyword>
						<SampleNumberPrefix>"Desc,Sample:",",</SampleNumberPrefix>
						<SampleNumberPostfix>,",,,,,,,,,,,,,</SampleNumberPostfix>
						<DataTypeKeyword>ProcessName</DataTypeKeyword>
						<DataTypePrefix>"Desc,ProcessName",",</DataTypePrefix>
						<DataTypePostfix>,",,,,,,,,,,,,,</DataTypePostfix>
						<DataTypeSplit>_</DataTypeSplit>
						<DataTypePos>1</DataTypePos>
						<EndFileString>NA</EndFileString>
				</Path6>
		</Paths>
		<startup>
				<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
		</startup>
		<runtime>
				<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
						<dependentAssembly>
								<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
								<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
						</dependentAssembly>
				</assemblyBinding>
		</runtime>
</configuration>
